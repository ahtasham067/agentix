{
  "name": "agentix",
  "version": "0.1.0",
  "private": true,
  "description": "Agentix website: chatbots and AI agents, automation, web development, and SEO and GEO.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:env": "node scripts/db-env.mjs",
    "db:seed:gen": "tsx scripts/generate-seed.ts",
    "db:test": "supabase test db",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run audit && npm run lint && npm run typecheck && npm test && npm run db:reset && npm run db:test && npm run build && npm run check:secrets && npm run test:e2e && npm run test:smoke && npm run test:cross-browser && npm run test:visual && npm run test:seo && npm run test:lighthouse",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts && prettier --write src/lib/supabase/database.types.ts",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "test:visual": "playwright test --project=visual",
    "test:seo": "playwright test --project=seo",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "test:smoke": "playwright test --project=smoke",
    "test:cross-browser": "playwright test --project=webkit-smoke --project=firefox-smoke",
    "audit:pages": "node scripts/audit-pages.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "email:test": "tsx --conditions=react-server scripts/email-test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.3",
    "nodemailer": "10.1.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.6.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "schema-dts": "^2.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
