# Copy to .env.local for local development (`npm run db:env` fills the Supabase values).
# Every variable the app reads is listed here. Never commit real values.

# --- Site ---------------------------------------------------------------
# Absolute origin used for canonical URLs, sitemap, Open Graph and JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (server only; never exposed to the browser) ---------------
SUPABASE_URL=http://127.0.0.1:57321
# Anon / publishable key. Used for public reads of published products and posts.
SUPABASE_ANON_KEY=
# Service role / secret key. Used only by the quote server action. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Quote form protection ---------------------------------------------
# Random secret mixed into the IP hash used for rate limiting.
IP_HASH_SALT=
# Max quote requests per IP within the window (defaults: 3 per 10 minutes).
RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW_MINUTES=10
# Header the hosting platform sets with the client IP. Vercel: x-real-ip. Never a
# header the visitor can send (for x-forwarded-for the last hop is used).
TRUSTED_IP_HEADER=x-real-ip

# --- Quote emails over SMTP (required in production) --------------------
# The server refuses to start in production without SMTP_HOST and EMAIL_FROM.
# Gmail (no domain needed): SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
#         SMTP_USER=<your Gmail address>, SMTP_PASS=<16-character App Password, no spaces>,
#         EMAIL_FROM=Agentix <your Gmail address>. Gmail always sends from the signed-in address.
#         App Passwords need 2-Step Verification: https://myaccount.google.com/apppasswords
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_SECURE=true,
#         SMTP_USER=resend, SMTP_PASS=<Resend API key>. Needs a verified domain.
# Local development uses Mailpit from `supabase start` (`npm run db:env` fills these).
# The e2e tests always use Mailpit, whatever is set here (see playwright.config.ts).
SMTP_HOST=127.0.0.1
SMTP_PORT=57325
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Verified sender address, for example: Agentix <quotes@agentix.website>
EMAIL_FROM=Agentix <quotes@agentix.website>
# Owner inbox for new quotes. Empty = NEXT_PUBLIC_CONTACT_EMAIL.
QUOTE_NOTIFY_TO=
# Also send the visitor a short confirmation email.
QUOTE_CONFIRMATION_ENABLED=false
# Mailpit web UI/API, used by the e2e email tests.
MAILPIT_URL=http://127.0.0.1:57324

# --- Contact details (footer, contact page, JSON-LD, llms.txt, WhatsApp link)
NEXT_PUBLIC_CONTACT_EMAIL=ahtasham067@gmail.com
# Digits with country code; shown as +92 302 5889452 and used for tel: and wa.me links.
NEXT_PUBLIC_CONTACT_PHONE=+923025889452

# --- Social profiles (footer and Organization JSON-LD) ------------------
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/ahtasham-naeem
NEXT_PUBLIC_GITHUB_URL=https://github.com/ahtasham067
# TODO: set the real Upwork profile URL.
NEXT_PUBLIC_UPWORK_URL=

# --- Analytics (off by default) -----------------------------------------
# One of: off, plausible, ga4
NEXT_PUBLIC_ANALYTICS=off
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=

# --- Search engine verification (meta tags; leave empty to skip) --------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- IndexNow (Bing, Yandex and others; served at /indexnow-key.txt) -----
# 8-128 letters, digits or dashes. Submit URLs with: node scripts/indexnow.mjs
INDEXNOW_KEY=

# --- On-demand revalidation (Supabase webhook -> /api/revalidate) ---
# Long random string. Leave empty to disable the endpoint.
REVALIDATE_SECRET=
